programme: VALBOOL
##
## Ends in an error in state: 0.
##
## programme' -> . programme [ # ]
##
## The known suffix of the stack is as follows:
##
##

on attend une instruction; pas une expression

programme: WHILE WHILE
##
## Ends in an error in state: 1.
##
## instruction -> WHILE . expression DO sous_bloc [ SEMICOLON ]
##
## The known suffix of the stack is as follows:
## WHILE
##

on attend une expression; "Tant que" est répété

programme: WHILE NOT WHILE
##
## Ends in an error in state: 4.
##
## expression -> NOT . expression [ THEN SEMICOLON RPAREN RCROCHET ORDRE MULTIPLICATIF MINUS MANY_TIMES EGALE DO COMA ADDITIF ]
##
## The known suffix of the stack is as follows:
## NOT
##

on attend une expression apres "Non"; un mot-clé d'instruction ne peut pas commencer une expression

