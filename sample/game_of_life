Def nbVoisineVivante (ligneCell, colonneCell)
Debut
    Var total = 0;
    Var l = ligneCell -1;
    Var c;
    Var tempo;

    Repeter 3 Fois
    Debut
        Si l >= 0 Et l < dimMatrice Alors
        Debut
            tempo = matrice.l;
            c = colonneCell -1;
            Repeter 3 Fois
            Debut
                Si c >= 0 Et c < dimMatrice Alors
                Debut
                    Si Non (l == ligneCell Et c == colonneCell) Alors
                    Debut
                        total = total + tempo.c;
                    Fin;
                Fin;
                c = c +1;
            Fin;
        Fin;
        l = l +1;
    Fin;
    Retourn total;
Fin;




Def distance (startLigne, startColonne, endLigne, endColonne)
Debut
    Var resultLigne = endLigne - startLigne;
    Var resultColonne = endColonne - startColonne;

    Retourn [resultLigne, resultColonne];
Fin;


