Var sizeSquare = sizeWindow / dimMatrice ;

Def grille () 
Debut 
    Def draw () 
    Debut 
        BaisserPinceau;
        Repeter 4 Fois 
        Debut 
            Avancer sizeSquare;
            Tourner -90;
        Fin;
        LeverPinceau;
    Fin;

    Var ligne = 0;
    Var colonne = 0;

    Tant que ligne != dimMatrice Faire 
    Debut 
        Tant que colonne != dimMatrice Faire 
        Debut
            draw ();
            Avancer sizeSquare;
            colonne = colonne + 1;
        Fin;
        colonne = 0;
        Tourner 180;
        Avancer dimMatrice * sizeSquare;
        Tourner 90;
        Avancer sizeSquare;
        Tourner 90;
        ligne = ligne +1;
    Fin;
